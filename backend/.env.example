# ValoStats database (docker compose up -d at the repository root).
DATABASE_URL=postgresql+psycopg://valostats:valostats@localhost:5433/valostats

# ValoQuests database, read only: active squad players and their competitive 5-stacks.
VALOQUESTS_DATABASE_URL=postgresql+psycopg://valorant:CHANGE_ME@localhost:5432/valorant_tracker

# HenrikDev API key, shared with ValoQuests (30 requests per minute).
HENRIK_API_KEY=CHANGE_ME

# Browser origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:4200"]

# Production settings for docker-compose.prod.yml. Development uses backend/.env instead.

# Public host served by Traefik.
PUBLIC_HOST=valostats.thomashtn.dev

# Shared Traefik on the VPS: its Docker network, HTTPS entrypoint and certificate resolver.
TRAEFIK_NETWORK=edge
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

# Docker network through which the backend reaches the VPS PostgreSQL 17.
DATABASE_NETWORK=database

# Dedicated database and role on that PostgreSQL (host is its container name on DATABASE_NETWORK).
DATABASE_URL=postgresql+psycopg://valostats:change-me@postgres:5432/valostats

# ValoQuests database, read only: active squad players and their competitive 5-stacks.
VALOQUESTS_DATABASE_URL=postgresql+psycopg://valostats_reader:change-me@postgres:5432/valo_quests

# HenrikDev API key, shared with ValoQuests (30 requests per minute).
HENRIK_API_KEY=change-me

# Browser origins allowed to call the API from another site (JSON list). Same origin needs none.
CORS_ORIGINS=["https://valostats.thomashtn.dev"]
